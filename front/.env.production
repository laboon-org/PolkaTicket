# Production Environment Variables for Polka Ticket
# Deployed to: polka-ticket.polkadot.cloud

# App Configuration
REACT_APP_NAME=Polka Ticket
REACT_APP_VERSION=1.1.0-stable

# Network Configuration (Shibuya Testnet)
REACT_APP_NETWORK=shibuya
REACT_APP_CHAIN_ID=81

# Mock Data Mode (no external API)
REACT_APP_USE_MOCK_DATA=true

# Feature Flags
REACT_APP_ENABLE_WALLET=true
REACT_APP_ENABLE_NFT=true
REACT_APP_ENABLE_XCM=true
REACT_APP_ENABLE_PRIVACY=true
REACT_APP_ENABLE_GOVERNANCE=true
